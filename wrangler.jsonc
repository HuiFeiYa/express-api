{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "express-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "express-api-db",
      "database_id": "95770494-1b2e-4544-8881-6401d3b0022c"
    }
  ]
}
